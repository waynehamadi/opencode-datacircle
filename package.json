{
  "name": "@datacircle/opencode",
  "version": "0.1.0",
  "description": "OpenCode plugin on Datacircle's open API: find the best GTM APIs. List every API and see which provider ranks first on each one. Search every provider's pricing plans. See where a provider ranks. No API key needed.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tools",
    "gtm",
    "gtm-apis",
    "api",
    "api-directory",
    "api-pricing",
    "b2b-data",
    "data-enrichment",
    "datacircle"
  ],
  "homepage": "https://datacircle.dev",
  "bugs": {
    "url": "https://github.com/waynehamadi/opencode-datacircle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynehamadi/opencode-datacircle.git"
  },
  "license": "MIT",
  "author": "Datacircle <wayne@datacircle.dev> (https://datacircle.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.6",
    "@opencode/plugin": "2.3.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
